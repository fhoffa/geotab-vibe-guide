  "files": {
    "map.html": "<!DOCTYPE html><html><head><meta charset='utf-8'><title>Animal Speed Map</title><link rel='stylesheet' href='https://unpkg.com/leaflet@1.9.4/dist/leaflet.css' integrity='sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=' crossorigin='anonymous'><script src='https://unpkg.com/leaflet@1.9.4/dist/leaflet.js' integrity='sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV/XN2GqaY=' crossorigin='anonymous'><\\/script></head><body style='margin:0;padding:0;font-family:Arial,sans-serif;'><div id='map' style='width:100%;height:100vh;'></div><script>var map;var markersGroup;function initMap(){map=L.map('map').setView([37.7749,-122.4194],4);L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{attribution:'OpenStreetMap'}).addTo(map);markersGroup=L.layerGroup().addTo(map);}function getAnimalEmoji(speed){if(!speed||speed===0)return'🐢';if(speed<=30)return'🐇';if(speed<=80)return'🐎';return'🐆';}function bindPopupClick(element,id){element.onclick=function(e){e.preventDefault();window.parent.location.hash='device,id:'+id;};}function loadVehicles(api){api.multiCall([['Get',{typeName:'Device',search:{resultsLimit:500}}],['Get',{typeName:'DeviceStatusInfo',search:{resultsLimit:500}}]],function(results){var devices=results[0];var statuses=results[1];var deviceMap={};for(var i=0;i<devices.length;i++){deviceMap[devices[i].id]=devices[i].name||'Unnamed Vehicle';}markersGroup.clearLayers();var latSum=0,lngSum=0,coordCount=0;for(var j=0;j<statuses.length;j++){var status=statuses[j];if(status.latitude&&status.longitude){var deviceId=status.device.id;var deviceName=deviceMap[deviceId]||'Unknown Asset';var speed=status.speed||0;var emoji=getAnimalEmoji(speed);var icon=L.divIcon({html:'<div style=\"font-size:24px;line-height:1;text-align:center;\">'+emoji+'</div>',className:'custom-emoji-marker',iconSize:[30,30],iconAnchor:[15,15]});var marker=L.marker([status.latitude,status.longitude],{icon:icon});var popupDiv=document.createElement('div');popupDiv.style.fontFamily='Arial, sans-serif';var link=document.createElement('a');link.textContent=deviceName;link.href='#';link.style.cssText='color:#2563eb;font-weight:bold;cursor:pointer;text-decoration:underline;display:block;margin-bottom:5px;';bindPopupClick(link,deviceId);popupDiv.appendChild(link);var speedText=document.createElement('div');speedText.textContent='Speed: '+speed+' km/h';popupDiv.appendChild(speedText);marker.bindPopup(popupDiv);markersGroup.addLayer(marker);latSum+=status.latitude;lngSum+=status.longitude;coordCount++;}}if(coordCount>0){map.setView([latSum/coordCount,lngSum/coordCount],5);}else{console.warn('No active coordinates found.');}},function(err){console.error('Animal Speed Map error:',err.message||err);});}geotab.addin['animal-speed-map']=function(){return{initialize:function(api,state,callback){initMap();loadVehicles(api);callback();},focus:function(api,state){loadVehicles(api);},blur:function(api,state){}};};<\\/script></body></html>"
  }
}
